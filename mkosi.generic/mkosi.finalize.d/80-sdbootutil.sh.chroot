#! /usr/bin/bash
set -x
set -e

loader_token=${IMAGE_ID%-"$SUBIMAGE"}
title=${loader_token//-/ }
loader_token=${loader_token,,}

ESP_PATH="/boot"

echo "*** Setup bootloader ($title) ***"

# Created by mkosi, we don't need that, will only trigger
# wrong decission by bootloader scripts
rmdir /efi

case "$ARCHITECTURE" in
    arm64) arch=aa64 ;;
    riscv64) arch=riscv64 ;;
    x86-64) arch=x64 ;;
    *) echo "Unknown arch $ARCHITECTURE"; exit 1 ;;
esac

mkdir /etc/kernel
echo "$loader_token" > /etc/kernel/entry-token
echo "quiet systemd.show_status=yes console=ttyS0,115200 console=tty0 security=selinux selinux=1" > /etc/kernel/cmdline

loader_type="grub2-bls"
secure_boot="no"
rpm -q systemd-boot && loader_type="systemd-boot"
rpm -q shim && secure_boot="yes"
if [ -s /etc/sysconfig/bootloader ]; then
    sed -i "s/^LOADER_TYPE=.*$/LOADER_TYPE=\"$loader_type\"/g" /etc/sysconfig/bootloader
    sed -i "s/^SECURE_BOOT=.*$/SECURE_BOOT=\"$secure_boot\"/g" /etc/sysconfig/bootloader
else
    echo "LOADER_TYPE=\"${loader_type}\"" >> /etc/sysconfig/bootloader
    echo "SECURE_BOOT=\"${secure_boot}\"" >> /etc/sysconfig/bootloader
fi

# install u-boot and other files for Raspberry Pi
if [ "$ARCHITECTURE" == "arm64" ] && [ -d /boot/vc ]; then
    ESP_PATH="/boot/efi"
    mkdir /boot/efi
    # u-boot-rpiarm64
    cp /boot/vc/ubootconfig.txt /boot/efi
    cp /boot/vc/u-boot.bin /boot/efi/
    # raspberrypi-firmware
    for f in start.elf start4.elf fixup.dat fixup4.dat bootcode.bin; do
	cp /boot/vc/$f /boot/efi/
    done
    # raspberrypi-firmware-config
    cp /boot/vc/config.txt /boot/efi/config.txt
    # raspberrypi-firmware-dt
    cp -r /boot/vc/*dtb /boot/vc/overlays /boot/efi/
fi

# install bootloader with sdbootutil
sdbootutil -v --no-random-seed --arch "$arch" \
	   --esp-path "${ESP_PATH}" --entry-token=auto --no-variables \
	   install

export hostonly_l=no # for dracut
sdbootutil -v --arch "$arch" --esp-path "${ESP_PATH}" --entry-token=auto \
	   --rootfs="label" --rootfs-data="root-$ARCHITECTURE" \
	   add-all-kernels
sdbootutil -v --arch "$arch" --esp-path "${ESP_PATH}" --no-variables \
	   set-timeout 5
